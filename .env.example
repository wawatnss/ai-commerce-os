# Database
POSTGRES_USER=ai_commerce
POSTGRES_PASSWORD=ai_commerce_password
POSTGRES_DB=ai_commerce
DATABASE_URL=postgresql+psycopg2://ai_commerce:ai_commerce_password@localhost:5432/ai_commerce

# Redis
REDIS_URL=redis://localhost:6379/0

# AI Providers
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Security
SECRET_KEY=your-secret-key-here-change-in-production

# Application
NODE_ENV=development
NEXT_PUBLIC_API_URL=http://localhost:8000
API_PORT=8000
WEB_PORT=3000
ADMIN_PORT=3001
ADMIN_BASE_PATH=/admin

# Security
RATE_LIMIT_PER_MINUTE=60

# Email (console, smtp, sendgrid, mailgun)
EMAIL_PROVIDER=console
EMAIL_FROM=noreply@ai-commerce.com
PUBLIC_ADMIN_URL=http://localhost:3001
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
EMAIL_API_KEY=
EMAIL_DOMAIN=

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID_FREE=price_...
STRIPE_PRICE_ID_PRO=price_...
STRIPE_PRICE_ID_BUSINESS=price_...

# Shopify (if using Shopify integration)
SHOPIFY_API_KEY=your_shopify_api_key
SHOPIFY_API_SECRET=your_shopify_api_secret
SHOPIFY_ACCESS_TOKEN=your_shopify_access_token
SHOPIFY_STORE_URL=your-shop.myshopify.com
